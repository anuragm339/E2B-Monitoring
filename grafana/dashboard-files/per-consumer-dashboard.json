      }
    },
    {
      "id": 12,
      "title": "Failed Bytes",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(broker_consumer_bytes_failed_bytes_total{topic=~\"$topic\",group=~\"$group\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10485760
              },
              {
                "color": "red",
                "value": 104857600
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Transfer Success Rate (%)",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 48,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(broker_consumer_bytes_sent_bytes_total{topic=~\"$topic\",group=~\"$group\"}) - (sum(broker_consumer_bytes_failed_bytes_total{topic=~\"$topic\",group=~\"$group\"}) or vector(0))) / (sum(broker_consumer_bytes_sent_bytes_total{topic=~\"$topic\",group=~\"$group\"}) + 0.01) * 100",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Consumer Health",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "((max by(topic, group) (clamp_min(max by(topic) (broker_topic_head_offset{topic=~\"$topic\"}) - on(topic) group_right(group) max by(topic, group) (broker_consumer_offset{topic=~\"$topic\",group=~\"$group\"}), 0)) > bool 0) * 2) + (((time() * 1000 - broker_consumer_last_ack_time_ms{topic=~\"$topic\",group=~\"$group\"}) / 1000 > bool 60) * 1)",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Active",
                  "color": "green"
                },
                "1": {
                  "text": "Idle",
                  "color": "blue"
                },
                "2": {
                  "text": "Catching Up",
                  "color": "yellow"
                },
                "3": {
                  "text": "Stalled",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "title": "Consumer Activity Timeline (Time Since Last Delivery/ACK)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "(time() * 1000 - broker_consumer_last_delivery_time_ms{topic=~\"$topic\",group=~\"$group\"}) / 1000",
          "refId": "A",
          "legendFormat": "{{group}}-{{topic}} (last delivery)"
        },
        {
          "expr": "(time() * 1000 - broker_consumer_last_ack_time_ms{topic=~\"$topic\",group=~\"$group\"}) / 1000",
          "refId": "B",
