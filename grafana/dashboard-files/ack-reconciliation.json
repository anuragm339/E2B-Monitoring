{
  "uid": "ack-reconciliation",
  "title": "Engineering - ACK Reconciliation",
  "description": "Shows whether each topic/group pair is consistent and where ACK gaps begin and end. Use this to investigate offset drift and replay issues.",
  "tags": [
    "engineering",
    "ack",
    "reconciliation"
  ],
  "schemaVersion": 42,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-datasource"
        },
        "query": "label_values(ack_reconciliation_missing_keys, topic)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-datasource"
        },
        "query": "label_values(ack_reconciliation_missing_keys{topic=~\"$topic\"}, group)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "System Consistency",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Overall System Consistent?",
      "description": "GREEN = all (topic, group) pairs are fully ACKed. RED = at least one pair has an ACK gap.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "count(ack_reconciliation_missing_keys{topic=~\"$topic\", group=~\"$group\"} > 0) or vector(0)",
          "legendFormat": "Inconsistent Pairs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CONSISTENT",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 9999,
                "result": {
                  "text": "INCONSISTENT",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "valueSize": 32
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Inconsistent Pairs",
      "description": "Number of (topic, group) pairs with at least one unACKed msgKey.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "count(ack_reconciliation_missing_keys{topic=~\"$topic\", group=~\"$group\"} > 0) or vector(0)",
          "legendFormat": "Pairs with gaps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Missing Keys",
      "description": "Sum of all unACKed msgKeys across all (topic, group) pairs.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "sum(ack_reconciliation_missing_keys{topic=~\"$topic\", group=~\"$group\"}) or vector(0)",
          "legendFormat": "Total missing",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Largest Single Gap (keys)",
      "description": "The single worst (topic, group) pair \u2014 highest count of unACKed keys.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "max(ack_reconciliation_missing_keys{topic=~\"$topic\", group=~\"$group\"}) or vector(0)",
          "legendFormat": "Worst pair",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Offset Gap Range \u2014 Where Is the Problem?",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "table",
      "title": "ACK Gap Details \u2014 Offset Range per (Topic, Group)",
      "description": "For each pair: how many keys are missing, the first missing offset (gap start), and the last missing offset (gap end). Gap width in offsets = gap_end - gap_start + 1. Consistent pairs show N/A.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "ack_reconciliation_missing_keys{topic=~\"$topic\", group=~\"$group\"}",
          "legendFormat": "{{topic}} / {{group}}",
          "refId": "missing",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "ack_reconciliation_gap_min_offset{topic=~\"$topic\", group=~\"$group\"}",
          "legendFormat": "{{topic}} / {{group}}",
          "refId": "gapMin",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "ack_reconciliation_gap_max_offset{topic=~\"$topic\", group=~\"$group\"}",
          "legendFormat": "{{topic}} / {{group}}",
          "refId": "gapMax",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "topic": "Topic",
              "group": "Group",
              "Value #missing": "Missing Keys",
              "Value #gapMin": "Gap Start (offset)",
              "Value #gapMax": "Gap End (offset)"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "Topic": 0,
              "Group": 1,
              "Missing Keys": 2,
              "Gap Start (offset)": 3,
              "Gap End (offset)": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [
              {
                "displayName": "Missing Keys",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Missing Keys"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gap Start (offset)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "N/A \u2014 consistent",
                        "color": "green",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gap End (offset)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "N/A \u2014 consistent",
                        "color": "green",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Value #missing"
          ]
        },
        "sortBy": [
          {
            "displayName": "Missing Keys",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Consistency Trend Over Time",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Missing Keys Over Time (per topic/group)",
      "description": "Any value > 0 means that pair is inconsistent at that point in time. Step-after interpolation shows the exact reconciliation cycles.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "ack_reconciliation_missing_keys{topic=~\"$topic\", group=~\"$group\"}",
          "legendFormat": "{{topic}} / {{group}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Inconsistent Pairs Count Over Time",
      "description": "Number of (topic, group) pairs with missing_keys > 0. Should always be 0 in steady state.",
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "count(ack_reconciliation_missing_keys{topic=~\"$topic\", group=~\"$group\"} > 0) or vector(0)",
          "legendFormat": "Inconsistent pairs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "drawStyle": "bars",
            "lineInterpolation": "stepAfter",
            "spanNulls": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Offset Gap Range Trend",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Gap Start Offset Over Time",
      "description": "Earliest offset with no ACK record. Only plotted when gap exists (value >= 0). A rising value means old messages are being ACKed and the gap is moving forward.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "ack_reconciliation_gap_min_offset{topic=~\"$topic\", group=~\"$group\"} >= 0",
          "legendFormat": "{{topic}} / {{group}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Gap End Offset Over Time",
      "description": "Latest offset with no ACK record. Only plotted when gap exists. Gap width = gap_end \u2212 gap_start + 1 offsets.",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "ack_reconciliation_gap_max_offset{topic=~\"$topic\", group=~\"$group\"} >= 0",
          "legendFormat": "{{topic}} / {{group}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Offset Gap Width Over Time (gap_end \u2212 gap_start)",
      "description": "Number of offsets spanned by the gap. Consistent pairs are excluded (only shown when gap > 0). Shrinking = ACKs catching up. Growing = more messages piling up un-ACKed.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "targets": [
        {
          "expr": "ack_reconciliation_gap_max_offset{topic=~\"$topic\", group=~\"$group\"} - ack_reconciliation_gap_min_offset{topic=~\"$topic\", group=~\"$group\"} > 0",
          "legendFormat": "{{topic}} / {{group}} \u2014 gap width",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    }
  ],
  "links": [
    {
      "title": "Delivery Diagnosis",
      "type": "link",
      "url": "/d/consumer-delivery-diagnosis",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Per-Consumer Deep Dive",
      "type": "link",
      "url": "/d/per-consumer-metrics",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ]
}
