    {
      "id": 14,
      "title": "Garbage Collection Activity",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{service=\"broker\"}[1m])",
          "legendFormat": "GC Events/sec - {{action}}",
          "refId": "A"
        },
        {
          "expr": "(rate(jvm_gc_pause_seconds_sum{service=\"broker\"}[1m]) / rate(jvm_gc_pause_seconds_count{service=\"broker\"}[1m]) * 1000) or vector(0)",
          "legendFormat": "GC Avg Pause (ms) - {{action}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/GC Events.*/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisLabel",
                "value": "Events/sec"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/GC Pause.*/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Pause Time (ms)"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
