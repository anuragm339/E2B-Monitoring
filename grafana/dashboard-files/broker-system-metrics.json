    {
      "id": 11,
      "title": "GC Activity Summary",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{service=\"broker\"}[1m]) * 60",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(jvm_gc_pause_seconds_sum{service=\"broker\"}[1m])) / sum(rate(jvm_gc_pause_seconds_count{service=\"broker\"}[1m]))) * 1000 or vector(0)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
